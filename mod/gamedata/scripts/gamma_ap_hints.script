-- AP item hints remain server-owned; this page only submits Say and shows replies.
function request(state, item)
    if type(item) ~= "string" then return false,"Enter an item name" end
    item = item:gsub("^%s+",""):gsub("%s+$","")
    if #item > 480 then return false,"Item name is too long" end
    return gamma_ap_communication.say(state,"!hint"..(item ~= "" and " "..item or ""))
end

function view(state, now)
    local status = gamma_ap_communication.view(state,now)
    local lines = {}
    local frame,reason
    if state.session_key then frame,reason = gamma_ap_room.snapshot(state) end
    if frame then
        for index=#frame.messages,math.max(1,#frame.messages-31),-1 do
            lines[#lines+1] = frame.messages[index].text
        end
    end
    if #lines == 0 then lines[1] = reason or "No server hint replies yet. Select Show my hints." end
    local budget = status.status
    if status.points then
        local price = status.cost == 0 and 0 or math.max(1,math.floor(status.cost*status.total/100))
        budget = budget..". Hint points: "..status.points.." | Cost per item hint: "..price.."."
    end
    return {budget=budget,lines=lines,status=status.status}
end
