-- Thin Anomaly adapter: all AP decisions live in state/protocol modules.
-- Deploy only through the isolated GAMMA MO2 instance.

local state = gamma_ap_state.new_state()
local next_poll = 0
local last_error = nil
local task_hook_registered = false
local known_receipts = 0

local function register_task_hook()
    if not task_hook_registered and gamma_ap_tasks.hook_available() then
        RegisterScriptCallback("actor_on_task_callback", actor_on_task_callback)
        task_hook_registered = true
    end
end

local function report_error(message)
    if message ~= last_error then
        printf("[GAMMA AP] %s", message)
        last_error = message
    end
end

local function bridge_path(filename)
    local root = gamma_ap_paths.appdata_root(getFS():update_path("$app_data_root$", ""))
    if not root then
        return nil, "AP add-on is allowed only in D:/AnomalyAP/appdata"
    end
    return root .. "archipelago\\" .. filename
end

local function read_incoming()
    local path, reason = bridge_path("incoming.txt")
    if not path then return nil, reason end
    local file = io.open(path, "rb")
    if not file then return nil, "Start the AP companion client before loading a test save" end
    local content = file:read(131073)
    file:close()
    return gamma_ap_protocol.parse_incoming(content)
end

local function write_outgoing()
    local path, reason = bridge_path("outgoing.txt")
    if not path then return false, reason end
    local file, open_error = io.open(path, "wb")
    if not file then return false, "Cannot write AP state: " .. tostring(open_error) end
    local written = file:write(gamma_ap_protocol.encode_outgoing(state))
    local closed = file:close()
    if not written or not closed then return false, "AP snapshot write failed" end
    return true
end

local function read_confirmed(key, allowed)
    local path, reason = bridge_path("confirmed_checks.txt")
    if not path then return nil, reason end
    local file = io.open(path, "rb")
    if not file then return {} end -- Compatible with older companions.
    local content = file:read(131073)
    local closed = file:close()
    if not closed then return nil, "Confirmed-check read close failed" end
    return gamma_ap_protocol.parse_confirmed(content, key, allowed)
end

local function read_configuration(incoming)
    if not incoming.configuration_key then return nil end
    local path, reason = bridge_path("configuration.txt")
    if not path then return nil, reason end
    local file = io.open(path, "rb")
    if not file then return nil, "Start the matching companion before loading this configured seed" end
    local content = file:read(131073)
    local closed = file:close()
    if not closed then return nil, "Configuration read close failed" end
    return gamma_ap_configuration.parse(content, incoming.session_key, incoming.configuration_key)
end

local function grant_reward(section)
    if type(section) == "number" then
        if gamma_ap_catalog.item_effects[section] == "convenience" then return gamma_ap_convenience.receive(state,section) end
        if gamma_ap_catalog.item_effects[section] == "progressive_tools" then return true end
        if gamma_ap_catalog.gear_rewards[section] then return gamma_ap_gear_locks.receive(state, section) end
        if gamma_ap_catalog.item_effects[section] == "unlock" then
            state.unlocks[gamma_ap_catalog.permissions[section]] = true
            return true
        end
        if gamma_ap_catalog.item_effects[section] == "skill" then
            return gamma_ap_skills.receive(state, section)
        end
        if gamma_ap_catalog.item_effects[section] == "reputation" then
            return gamma_ap_reputation.receive(state, section)
        end
        return gamma_ap_stashes.receive(state, section)
    end
    state.applying_reward = true
    local ok, object = pcall(alife_create_item, section, db.actor)
    state.applying_reward = false
    if not ok or not object then return false end
    printf("[GAMMA AP] Received %s", section)
    return true
end

local function apply_reward(section)
    if type(section) == "number" and gamma_ap_catalog.item_effects[section] == "supply_package" then
        return gamma_ap_deliveries.receive(state,section,grant_reward)
    end
    if type(section) == "number" and state.configuration and state.configuration.options.permission_supplies == 1
        and gamma_ap_catalog.delivery_contents[section] then
        return gamma_ap_deliveries.receive(state,section,grant_reward)
    end
    return grant_reward(section)
end

function actor_on_update()
    if not db.actor or not db.actor:alive() then return end
    local now = time_global()
    if now < next_poll then return end
    next_poll = now + 500
    local carried,carry_error = gamma_ap_convenience.poll(state)
    if not carried then report_error(carry_error); return end
    if state.refused_save then report_error("AP save is refused; restore a valid backup"); return end
    local incoming, reason = read_incoming()
    if not incoming then report_error(reason); return end
    local configuration, configuration_error = read_configuration(incoming)
    if incoming.configuration_key and not configuration then report_error(configuration_error); return end
    local pickup_ready, pickup_error = gamma_ap_gear_locks.install_pickup_guard(configuration)
    if not pickup_ready then report_error(pickup_error); return end
    local quest_ready, quest_error = gamma_ap_quest_keys.install(function() return state end)
    if configuration and configuration.expanded and configuration.options.rewards_quest_keys == 1
        and not quest_ready then report_error(quest_error); return end
    local zones_ready, zone_error = gamma_ap_zone_keys.install(function() return state end)
    if configuration and configuration.expanded and configuration.options.rewards_zone_keys == 1
        and not zones_ready then report_error(zone_error); return end
    local workshop_ready, workshop_error = gamma_ap_workshop.install(configuration,function() return state end)
    if not workshop_ready then report_error(workshop_error); return end
    local shop_ready,shop_error = gamma_ap_shop_ui.install(configuration)
    register_task_hook()
    local supported, support_error = gamma_ap_tasks.supported(configuration)
    if not supported then report_error(support_error); return end
    local enabled = gamma_ap_state.enabled_locations(configuration)
    local confirmed, confirmed_error = read_confirmed(incoming.session_key, enabled)
    if not confirmed then report_error(confirmed_error); return end
    local bound, bind_error = gamma_ap_state.bind_session(state, incoming)
    if not bound then report_error(bind_error); return end
    known_receipts = #incoming.items
    local ready, loadout_error = gamma_ap_loadout.apply(state, configuration)
    if not ready then report_error(loadout_error); return end
    state.expanded = configuration and configuration.expanded or false
    state.enabled_checks = enabled
    state.allowed_items = gamma_ap_state.enabled_items(configuration)
    state.configuration = gamma_ap_configuration.copy(configuration)
    local zone_valid, zone_reason = gamma_ap_zone_keys.validate_start(state)
    if not zone_valid then report_error(zone_reason); return end
    gamma_ap_combat.configure(state.combat, configuration)
    gamma_ap_tasks.configure(state.tasks, configuration)
    local ranked, rank_error = gamma_ap_rank.poll(state, configuration)
    if not ranked then report_error(rank_error); return end
    gamma_ap_state.merge_confirmed(state, confirmed)
    gamma_ap_state.check_level(state, level.name())
    local services, service_error = gamma_ap_services.poll(state)
    if not services then report_error(service_error); return end
    local permitted, permission_error = gamma_ap_gear_locks.poll(state)
    if permitted then
        local goal_ready, goal_reason = gamma_ap_goals.poll(state)
        if not goal_ready then report_error(goal_reason); return end
        local equipped, equipment_error = gamma_ap_equipment_checks.poll(state, configuration)
        if not equipped then report_error(equipment_error); return end
    end
    local quests, quest_error = gamma_ap_quest_keys.poll(state)
    if not quests then report_error(quest_error); return end
    local zones, zone_problem = gamma_ap_zone_keys.poll(state)
    local stashed, stash_error = gamma_ap_stashes.poll(state)
    local success, delivery_error = gamma_ap_state.apply_pending(state, incoming, apply_reward)
    local written, write_error = write_outgoing()
    if not written then report_error(write_error); return end
    local notified, notice_error = gamma_ap_notifications.poll(state)
    if not notified then report_error(notice_error); return end
    local joined, join_error = gamma_ap_presence.poll(state,now)
    local scouted, scout_error = gamma_ap_scouting.write_requests(state)
    if not scouted then report_error(scout_error); return end
    if not success then report_error(delivery_error)
    elseif not joined then report_error(join_error)
    elseif not permitted then report_error(permission_error)
    elseif not zones then report_error(zone_problem)
    elseif not stashed then report_error(stash_error)
    elseif not shop_ready then report_error(shop_error)
    else last_error = nil end
end

function actor_on_interaction(kind, object, name)
    if not db.actor or not db.actor:alive() then return end
    gamma_ap_settlements.observe(state, kind, object, name, level.name())
end

function actor_on_leave_dialog(npc_id)
    local ok,reason = gamma_ap_goals.left_dialog(state,npc_id,level.name())
    if not ok then report_error(reason) end
end

function npc_on_death_callback(victim, killer)
    gamma_ap_combat.observe(state, "faction", victim, killer)
end

function monster_on_death_callback(victim, killer)
    gamma_ap_combat.observe(state, "mutant", victim, killer)
end

function monster_on_hit_callback(victim, amount, direction, killer, bone)
    if bone == "from_death_callback" then monster_on_death_callback(victim, killer) end
end

function creature_spawned(victim)
    gamma_ap_combat.spawned(state, victim)
end

function actor_on_item_take(item)
    local permitted, reason = gamma_ap_gear_locks.taken(state, item)
    if not permitted then report_error(reason); return end
    gamma_ap_collection.observe(state, item, "ownership")
    local ok, reason = gamma_ap_equipment_checks.acquired(state, item)
    if not ok then report_error(reason) end
    gamma_ap_stashes.take(state, nil, item)
end

function actor_on_item_take_from_box(box, item)
    local permitted, reason = gamma_ap_gear_locks.taken(state, item)
    if not permitted then report_error(reason); return end
    gamma_ap_collection.observe(state, item, "container")
    local ok, reason = gamma_ap_equipment_checks.acquired(state, item)
    if not ok then report_error(reason) end
    gamma_ap_stashes.take(state, box, item)
end

function actor_on_item_before_pickup(item, flags)
    gamma_ap_gear_locks.before_pickup(state, item, flags)
end

function actor_on_item_before_use(item, flags)
    gamma_ap_gear_locks.before(state, item, flags)
end

function physic_object_on_use_callback(box, who)
    local ok, reason = gamma_ap_stashes.open(state, box, who)
    if not ok then report_error(reason) end
end

function actor_on_task_callback(object, status, manager, id)
    local ok, reason = gamma_ap_tasks.observe(state, object, status, manager, id)
    if not ok then report_error(reason) end
end

function save_state(data)
    data.gamma_archipelago_v1 = gamma_ap_state.copy_state(state)
end

function load_state(data)
    gamma_ap_readiness.reset()
    if data.gamma_archipelago_v1 ~= nil then
        local ran, valid, reason = pcall(gamma_ap_save_validation.validate, data.gamma_archipelago_v1)
        if not ran or not valid then
            state = gamma_ap_state.new_state()
            state.refused_save = true
            report_error(ran and reason or "AP save validation failed; restore a valid backup")
            return
        end
    end
    local prepared, configuration_key = state.loadout_prepared, state.configuration_key
    local configuration, pending = state.configuration, state.quest_pending
    local copied, restored = pcall(gamma_ap_state.copy_state, data.gamma_archipelago_v1 or gamma_ap_state.new_state())
    if not copied then
        state = gamma_ap_state.new_state()
        state.refused_save = true
        report_error("AP save structure is incompatible; restore a valid backup")
        return
    end
    state = restored
    gamma_ap_presence.reset()
    if not data.gamma_archipelago_v1 and prepared then
        state.loadout_prepared, state.configuration_key = true, configuration_key
    end
    if not data.gamma_archipelago_v1 then
        state.configuration, state.quest_pending = configuration, pending
    end
    next_poll = 0
    last_error = nil
end

function on_game_start()
    gamma_ap_readiness.reset()
    state = gamma_ap_state.new_state()
    known_receipts = 0
    gamma_ap_scouting.reset()
    gamma_ap_presence.reset()
    gamma_ap_convenience.reset()
    next_poll = 0
    last_error = nil
    task_hook_registered = false
    local incoming = read_incoming()
    if incoming and incoming.configuration_key then
        local configuration, reason = read_configuration(incoming)
        if configuration then
            state.configuration = gamma_ap_configuration.copy(configuration)
            local pickup_ready, pickup_error = gamma_ap_gear_locks.install_pickup_guard(configuration)
            if not pickup_ready then report_error(pickup_error) end
            gamma_ap_quest_keys.install(function() return state end)
            gamma_ap_zone_keys.install(function() return state end)
            local prepared, error = gamma_ap_loadout.prepare(state, configuration)
            if not prepared then report_error(error) end
        else report_error(reason) end
    end
    RegisterScriptCallback("actor_on_update", actor_on_update)
    RegisterScriptCallback("on_loading_screen_key_prompt", gamma_ap_readiness.reset)
    RegisterScriptCallback("on_loading_screen_dismissed", gamma_ap_readiness.dismissed)
    RegisterScriptCallback("actor_on_net_destroy", gamma_ap_readiness.reset)
    RegisterScriptCallback("save_state", save_state)
    RegisterScriptCallback("load_state", load_state)
    RegisterScriptCallback("actor_on_interaction", actor_on_interaction)
    RegisterScriptCallback("actor_on_leave_dialog", actor_on_leave_dialog)
    RegisterScriptCallback("npc_on_death_callback", npc_on_death_callback)
    RegisterScriptCallback("monster_on_death_callback", monster_on_death_callback)
    RegisterScriptCallback("monster_on_hit_callback", monster_on_hit_callback)
    RegisterScriptCallback("npc_on_net_spawn", creature_spawned)
    RegisterScriptCallback("monster_on_net_spawn", creature_spawned)
    RegisterScriptCallback("actor_on_item_take", actor_on_item_take)
    RegisterScriptCallback("actor_on_item_take_from_box", actor_on_item_take_from_box)
    RegisterScriptCallback("actor_on_item_before_pickup", actor_on_item_before_pickup)
    RegisterScriptCallback("actor_on_item_before_use", actor_on_item_before_use)
    RegisterScriptCallback("actor_on_trade", actor_on_trade)
    RegisterScriptCallback("physic_object_on_use_callback", physic_object_on_use_callback)
    register_task_hook()
    printf("[GAMMA AP] Pilot loaded; multiplayer roots are forbidden")
end


function preview_unlock_travel()
    return gamma_ap_travel.preview(state)
end

function take_unlock_travel()
    return gamma_ap_travel.take(state)
end

function tracker_view()
    local ok, psi = pcall(function()
        local helmet = db.actor:object("good_psy_helmet")
        return helmet ~= nil and helmet:condition() > 0 and helmet:condition() <= 1
    end)
    local view = gamma_ap_tracker.snapshot(state,known_receipts,last_error,ok and psi)
    local scouting = gamma_ap_scouting.view(state,time_global())
    view.scouted,view.connection_status = scouting.rewards,scouting.status
    view.previews = gamma_ap_scouting.previews(state)
    view.scouting_enabled = state.configuration and (state.configuration.options.scouting_mode or 0) > 0
    return view
end

function request_scout(id)
    local queued,reason = gamma_ap_scouting.request(state,id)
    if not queued then return false,reason end
    local written,error = gamma_ap_scouting.write_requests(state)
    return written,written and reason or error
end

function actor_on_trade(item, sold, money)
    local ok,reason = gamma_ap_services.traded(state,item,sold,money)
    if not ok then report_error(reason) end
end

function shop_view()
    local view = gamma_ap_shop.snapshot(state)
    if #view.rows>0 and state.configuration and (state.configuration.options.scouting_mode or 0)>0 then
        local scouting = gamma_ap_scouting.view(state,time_global())
        for _,row in ipairs(view.rows) do row.reward = scouting.rewards[row.id] end
    end
    return view
end

function buy_shop_check(id, session_key, npc_id)
    local incoming,reason = read_incoming()
    if not incoming or incoming.session_key ~= state.session_key
        or incoming.configuration_key ~= state.configuration_key then
        return false,reason or "The AP shop session has changed; reopen the matching game"
    end
    local bound,binding_error = gamma_ap_state.bind_session(state,incoming)
    if not bound then return false,binding_error end
    local configuration,error = read_configuration(incoming)
    if not configuration or configuration.options.checks_shop_purchases ~= 1 then
        return false,error or "Paid shop checks are not enabled in this seed"
    end
    local confirmed,problem = read_confirmed(state.session_key,state.enabled_checks)
    if not confirmed then return false,problem end
    gamma_ap_state.merge_confirmed(state,confirmed)
    local paid,message = gamma_ap_shop.purchase(state,id,session_key,npc_id)
    if paid then
        local written,error = write_outgoing()
        if not written then
            report_error(error)
            return true,"Purchase saved locally; AP delivery will retry when the game resumes"
        end
    end
    return paid,message
end
