-- Personal faction goodwill only; never change faction alliances or NPC flags.

local function read(faction)
    if not relation_registry or type(relation_registry.community_goodwill) ~= "function"
        or type(relation_registry.set_community_goodwill) ~= "function" then
        return nil,"Faction rewards require the personal goodwill API"
    end
    local ok,current,id = pcall(function()
        local id = db.actor:id()
        if type(id) ~= "number" or id ~= math.floor(id) or id < 0 or id >= 65535 then error("Invalid actor identity") end
        return relation_registry.community_goodwill(faction,id),id
    end)
    if not ok or type(current) ~= "number" or current ~= math.floor(current)
        or current < -2147483648 or current > 2147483647 then
        return nil,"Faction goodwill query returned an invalid value"
    end
    return current,id
end

local function set_and_confirm(faction, id, target)
    local changed = pcall(relation_registry.set_community_goodwill,faction,id,target)
    if not changed then return false,"Faction goodwill update failed; the same target will retry" end
    local queried,actual = pcall(relation_registry.community_goodwill,faction,id)
    if not queried or actual ~= target then return false,"Faction goodwill update was not confirmed" end
    return true
end

function copy_targets(source)
    local result={}
    for receipt,target in pairs(source or {}) do
        if type(target) == "table" then
            result[receipt]={}
            for faction,value in pairs(target) do result[receipt][faction]=value end
        else result[receipt]=target end
    end
    return result
end

function validate_targets(state)
    if state.reputation_targets == nil then return true end
    if type(state.reputation_targets) ~= "table" then return false end
    local function integer(value, low, high)
        return type(value) == "number" and value == math.floor(value) and value >= low and value <= high
    end
    for receipt,target in pairs(state.reputation_targets) do
        if not integer(receipt,1,math.min(4000,state.received_count+1)) then return false end
        if type(target) == "table" then
            local config=state.configuration and state.configuration.options or {}
            if config.shared_faction_goodwill ~= 1 and config.shared_faction_goodwill ~= 2 and not (state.goodwill_migration and state.goodwill_migration.completed) then return false end
            if receipt <= state.received_count and state.applied_items[receipt] ~= gamma_ap_catalog.shared_goodwill_id and state.applied_items[receipt] ~= gamma_ap_catalog.allied_goodwill_id
                and not (state.goodwill_migration and state.applied_items[receipt] == 28051301) then return false end
            local count=0
            for _ in pairs(target) do count=count+1 end
            local item=state.applied_items[receipt]
            local allied=gamma_ap_goodwill_scope.group(state,item) == "allied"
                or (receipt > state.received_count and (config.shared_faction_goodwill == 2
                    or gamma_ap_goodwill_scope.group(state,28051301) == "allied"))
            if count ~= 8 and not (count == 5 and allied) then return false end
            if item == gamma_ap_catalog.allied_goodwill_id and count ~= 5 then return false end
            if count == 8 and receipt > state.received_count and config.shared_faction_goodwill == 2 then return false end
            for _,faction in ipairs(gamma_ap_goodwill_scope.factions(count == 5 and "allied" or "all")) do
                if not integer(target[faction],-2147483648,2147483647) then return false end
            end
        elseif not integer(target,-2147483648,2147483647) then return false end
    end
    return true
end

local function shared_targets(state, reward, receipt, item_id)
    local targets=state.reputation_targets[receipt]
    if type(targets) == "table" then return targets end
    local legacy_target=targets
    targets={}
    local floors=gamma_ap_settlement_access.minimum_goodwill(state,item_id)
    for _,faction in ipairs(gamma_ap_goodwill_scope.factions(gamma_ap_goodwill_scope.group(state,item_id))) do
        local current,problem=read(faction)
        if current == nil then return nil,problem end
        targets[faction]=faction == "stalker" and legacy_target or
            math.max(current,floors[faction] or -2147483648,math.min(reward.cap,current+reward.bonus))
    end
    -- Plan every faction before the first mutation; retries reuse absolute targets.
    state.reputation_targets[receipt]=targets
    return targets
end

function receive(state, item_id)
    local reward = gamma_ap_catalog.reputation_rewards[item_id]
    if not state.session_key or not state.expanded or not state.allowed_items[item_id] or not reward then
        return false, "Faction reward is disabled in this seed"
    end
    local receipt = state.received_count + 1
    if gamma_ap_goodwill_scope.group(state,item_id) then
        local targets,problem=shared_targets(state,reward,receipt,item_id)
        if not targets then return false,problem end
        for _,faction in ipairs(gamma_ap_goodwill_scope.factions(gamma_ap_goodwill_scope.group(state,item_id))) do
            local current,id=read(faction)
            if current == nil then return false,id end
            if current < targets[faction] then
                local ok,reason=set_and_confirm(faction,id,targets[faction])
                if not ok then return false,reason end
            end
        end
        return true
    end
    local current,id = read(reward.faction)
    if current == nil then return false,id end
    local target = state.reputation_targets[receipt]
    if not target then
        local floor = gamma_ap_settlement_access.minimum_goodwill(state,item_id)[reward.faction] or -2147483648
        target = math.max(current, floor, math.min(reward.cap, current + reward.bonus))
        state.reputation_targets[receipt] = target
    end
    if current >= target then return true end
    return set_and_confirm(reward.faction,id,target)
end

function reconcile(state)
    if (state.goodwill_migration and not state.goodwill_migration.completed) or (state.goodwill_repair and not state.goodwill_repair.completed) then return true end
    local floors = gamma_ap_settlement_access.minimum_goodwill(state)
    for faction,target in pairs(floors) do
        local current,id = read(faction)
        if current == nil then return false,id end
        if current < target then
            local ok,reason = set_and_confirm(faction,id,target)
            if not ok then return false,reason end
        end
    end
    return true
end

function plan_backfill(state, amount, scope)
    local targets={}
    for _,faction in ipairs(gamma_ap_goodwill_scope.factions(scope or "all")) do
        if faction ~= "stalker" then
            local current,problem=read(faction)
            if current == nil then return nil,problem end
            targets[faction]=math.max(current,math.min(3000,current+amount))
        end
    end
    return targets
end

function apply_backfill(targets)
    for faction in pairs(targets) do
        if faction ~= "stalker" then
            local current,id=read(faction)
            if current == nil then return false,id end
            if current < targets[faction] then
                local ok,reason=set_and_confirm(faction,id,targets[faction])
                if not ok then return false,reason end
            end
        end
    end
    return true
end

function current(faction) return read(faction) end
function set_target(faction,target)
    local current,id=read(faction)
    if current == nil then return false,id end
    return set_and_confirm(faction,id,target)
end
