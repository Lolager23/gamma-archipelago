-- The base smart-terrain update emits smarts callbacks within 50 metres.

function observe(state, kind, object, name, level_name)
    if not state.session_key or not state.expanded or kind ~= "smarts" then return end
    local definition = gamma_ap_catalog.settlements[name]
    if not definition or not state.enabled_checks[definition.id] then return end
    if level_name ~= definition.level or not object or not object.online
        or object:name() ~= name then return end
    local distance = object.dist_to_actor
    if type(distance) ~= "number" or distance ~= distance or distance < 0
        or distance > definition.radius then return end
    local allowed,reason = gamma_ap_settlement_access.native_allowed(state,definition.id)
    if allowed == nil then return false,reason end
    if allowed then state.checks[definition.id] = true end
end
