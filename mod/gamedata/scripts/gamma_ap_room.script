-- Transient room news: never acknowledge rewards or mutate saved progression.
local key,epoch,heartbeat,changed_at,cursor,live = nil,nil,nil,nil,0,false
local dirty=false

function parse(content, session, configuration)
    if type(content) ~= "string" or #content > 280000 or content:sub(-1) ~= "\n" then
        return nil,"Incomplete or oversized room feed"
    end
    local lines = {}
    for line in content:gmatch("([^\n]*)\n") do lines[#lines+1] = line end
    if #lines < 5 or lines[1] ~= "GAMMA_AP_ROOM|1" or lines[2] ~= "session|"..session
        or lines[3] ~= "configuration|"..(configuration or "-") then return nil,"Room feed identity mismatch" end
    local token,count = lines[4]:match("^heartbeat|([0-9a-f]+)|(%d+)$")
    count = gamma_ap_protocol.canonical_number(count)
    local total = gamma_ap_protocol.canonical_number(lines[#lines]:match("^end|(%d+)$"))
    if not token or #token ~= 16 or not count or count < 1 or count > 999999999
        or not total or total > 64 or total ~= #lines-5 then return nil,"Malformed room feed header" end
    local messages,previous = {},0
    for index=5,#lines-1 do
        local sequence,hex = lines[index]:match("^message|(%d+)|([0-9a-f]+)$")
        sequence = gamma_ap_protocol.canonical_number(sequence)
        if not sequence or sequence <= previous or sequence > 999999999 or not hex
            or #hex > 4096 or #hex%2 ~= 0 then return nil,"Malformed room message" end
        local text = hex:gsub("%x%x",function(pair) return string.char(tonumber(pair,16)) end)
        if text:find("[%z\1-\31\127%%<>|%[%]]") then return nil,"Unsafe room message" end
        messages[#messages+1],previous = {sequence=sequence,text=text},sequence
    end
    return {epoch=token,heartbeat=count,messages=messages}
end

function snapshot(state)
    local root = gamma_ap_paths.bridge_root(getFS():update_path("$app_data_root$",""),io.open)
    if not root then return nil,"Room feed requires isolated appdata" end
    local file = io.open(root.."archipelago\\room_feed.txt","rb")
    if not file then return nil end
    local content,closed = file:read(280001),file:close()
    if not closed then return nil,"Room feed read close failed" end
    local frame,reason = parse(content,state.session_key,state.configuration_key)
    return frame,reason
end

local function cursor_file(state, frame, root)
    local path=root.."archipelago\\room_cursor.txt"
    local file=io.open(path,"rb")
    if not file then
        -- First upgrade baselines the old buffer, before the loading gate opens.
        return #frame.messages > 0 and frame.messages[#frame.messages].sequence or 0,path
    end
    local text,closed=file:read(1025),file:close()
    if not closed or type(text) ~= "string" or #text > 1024 then return nil,"Room cursor read failed" end
    local session,config,token,sequence=text:match("^GAMMA_AP_CURSOR|1\nsession|([0-9a-f]+)\nconfiguration|([0-9a-f%-]+)\nepoch|([0-9a-f]+)\ncursor|(%d+)\nend|1\n$")
    sequence=gamma_ap_protocol.canonical_number(sequence)
    if not session or #session ~= 64 or (config ~= "-" and (#config ~= 64 or not config:match("^[0-9a-f]+$"))) or not token or #token ~= 16
        or not sequence or sequence > 999999999 then return nil,"Malformed room cursor" end
    return session==state.session_key and config==(state.configuration_key or "-") and token==frame.epoch and sequence or 0,path
end

local function persist(state, path)
    dirty=true
    local file=io.open(path,"wb")
    if not file then return false,"Cannot write room cursor" end
    local text=table.concat({"GAMMA_AP_CURSOR|1","session|"..state.session_key,
        "configuration|"..(state.configuration_key or "-"),"epoch|"..epoch,"cursor|"..cursor,"end|1",""},"\n")
    local written,closed=file:write(text),file:close()
    if not written or not closed then return false,"Room cursor write failed" end
    dirty=false
    return true
end

function poll(state, now)
    if not state.session_key then return true end
    local frame,reason = snapshot(state)
    if not frame then return not reason,reason end
    local root=gamma_ap_paths.bridge_root(getFS():update_path("$app_data_root$",""),io.open)
    local path=root.."archipelago\\room_cursor.txt"
    if key ~= state.session_key or epoch ~= frame.epoch then
        local restored,destination=cursor_file(state,frame,root)
        if not restored then return false,destination end
        key,epoch,heartbeat,changed_at,cursor = state.session_key,frame.epoch,frame.heartbeat,now,restored
        live = false
        return persist(state,destination)
    end
    if dirty then
        local ok,problem=persist(state,path)
        if not ok then return false,problem end
    end
    if now < changed_at then changed_at=now end
    if frame.heartbeat > heartbeat then heartbeat,changed_at,live=frame.heartbeat,now,true end
    if now-changed_at > 5000 or not live or not gamma_ap_readiness.ready() then return true end
    for _,message in ipairs(frame.messages) do
        if message.sequence > cursor then
            local shown = pcall(function()
                db.actor:give_game_news("Archipelago",message.text,"ui_inGame2_D_Svyazist",0,5000)
            end)
            if not shown then return false,"Room news display failed" end
            cursor = message.sequence
            return persist(state,path)
        end
    end
    return true
end
