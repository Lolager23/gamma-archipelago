-- Transient room news: never acknowledge rewards or mutate saved progression.
local key,epoch,heartbeat,changed_at,cursor,live = nil,nil,nil,nil,0,false

function parse(content, session, configuration)
    if type(content) ~= "string" or #content > 280000 or content:sub(-1) ~= "\n" then
        return nil,"Incomplete or oversized room feed"
    end
    local lines = {}
    for line in content:gmatch("([^\n]*)\n") do lines[#lines+1] = line end
    if #lines < 5 or lines[1] ~= "GAMMA_AP_ROOM|1" or lines[2] ~= "session|"..session
        or lines[3] ~= "configuration|"..(configuration or "-") then return nil,"Room feed identity mismatch" end
    local token,count = lines[4]:match("^heartbeat|([0-9a-f]+)|(%d+)$")
    count = gamma_ap_protocol.canonical_number(count)
    local total = gamma_ap_protocol.canonical_number(lines[#lines]:match("^end|(%d+)$"))
    if not token or #token ~= 16 or not count or count < 1 or count > 999999999
        or not total or total > 64 or total ~= #lines-5 then return nil,"Malformed room feed header" end
    local messages,previous = {},0
    for index=5,#lines-1 do
        local sequence,hex = lines[index]:match("^message|(%d+)|([0-9a-f]+)$")
        sequence = gamma_ap_protocol.canonical_number(sequence)
        if not sequence or sequence <= previous or sequence > 999999999 or not hex
            or #hex > 4096 or #hex%2 ~= 0 then return nil,"Malformed room message" end
        local text = hex:gsub("%x%x",function(pair) return string.char(tonumber(pair,16)) end)
        if text:find("[%z\1-\31\127%%<>|%[%]]") then return nil,"Unsafe room message" end
        messages[#messages+1],previous = {sequence=sequence,text=text},sequence
    end
    return {epoch=token,heartbeat=count,messages=messages}
end

function poll(state, now)
    if not state.session_key or not gamma_ap_readiness.ready() then return true end
    local root = gamma_ap_paths.bridge_root(getFS():update_path("$app_data_root$",""),io.open)
    if not root then return false,"Room feed requires isolated appdata" end
    local file = io.open(root.."archipelago\\room_feed.txt","rb")
    if not file then return true end
    local content,closed = file:read(280001),file:close()
    if not closed then return false,"Room feed read close failed" end
    local frame,reason = parse(content,state.session_key,state.configuration_key)
    if not frame then return false,reason end
    if key ~= state.session_key or epoch ~= frame.epoch then
        key,epoch,heartbeat,changed_at,cursor = state.session_key,frame.epoch,frame.heartbeat,now,0
        live = false
        return true
    end
    if now < changed_at then changed_at=now end
    if frame.heartbeat > heartbeat then heartbeat,changed_at,live=frame.heartbeat,now,true end
    if now-changed_at > 5000 then return true end
    -- A new epoch must advance before cached news can be displayed.
    if not live then return true end
    for _,message in ipairs(frame.messages) do
        if message.sequence > cursor then
            local shown = pcall(function()
                db.actor:give_game_news("Archipelago",message.text,"ui_inGame2_D_Svyazist",0,5000)
            end)
            if not shown then return false,"Room news display failed" end
            cursor = message.sequence
            break
        end
    end
    return true
end
