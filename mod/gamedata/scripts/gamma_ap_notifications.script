-- Versioned optional sidecar: receipt application never depends on PDA success.

local MAX_NOTICES = 8000

local function valid_item_id(text)
    -- Compare canonical decimal strings to preserve AP's exact signed 53-bit IDs.
    local magnitude = text:gsub("^%-", "")
    if magnitude == "0" and text ~= "0" then return false end
    if #magnitude > 16 or (magnitude ~= "0" and not magnitude:match("^[1-9]%d*$")) then
        return false
    end
    return #magnitude < 16 or magnitude <= "9007199254740991"
end

local function valid_id(id)
    local received = id:match("^r:(%d+)$")
    if received then
        local number = gamma_ap_protocol.canonical_number(received)
        return number ~= nil and number < 4000
    end
    local location, slot, item = id:match("^s:(%d+):(%d+):(%-?%d+)$")
    return gamma_ap_protocol.canonical_number(location) ~= nil
        and gamma_ap_protocol.canonical_number(slot) ~= nil
        and valid_item_id(item)
end

local function hex_text(hex, maximum)
    if not hex or #hex == 0 or #hex > maximum * 2 or #hex % 2 ~= 0 then return nil end
    local text = hex:gsub("%x%x", function(pair) return string.char(tonumber(pair, 16)) end)
    if text:find("[%z\1-\31\127%%<>|%[%]]") then return nil end
    return text
end

local function record(line, semantic)
    local id, receipt, hex
    if semantic then
        local kind, player, item, local_id
        id, receipt, kind, player, item, local_id = line:match("^notice|([^|]+)|([^|]+)|([^|]+)|([0-9a-f]+)|([0-9a-f]+)|([^|]+)$")
        if id then
            player, item = hex_text(player,384), hex_text(item,384)
            local_id = gamma_ap_protocol.canonical_number(local_id)
            if not gamma_ap_notice_text.valid(kind,player,item,local_id)
                or (kind:sub(1,5) == "sent_") ~= (id:sub(1,2) == "s:") then return nil end
            return {id=id, receipt=gamma_ap_protocol.canonical_number(receipt), kind=kind,
                player=player, item=item, local_item_id=local_id}
        end
        id, receipt, hex = line:match("^notice|([^|]+)|([^|]+)|text|([0-9a-f]+)$")
    else
        id, receipt, hex = line:match("^notice|([^|]+)|([^|]+)|([0-9a-f]+)$")
    end
    local text = hex_text(hex,2048)
    if not text then return nil end
    return {id=id, receipt=gamma_ap_protocol.canonical_number(receipt), text=text}
end

function parse(content, key)
    if type(content) ~= "string" or #content > 131072 or content:sub(-1) ~= "\n" then
        return nil, "Incomplete or oversized notice snapshot"
    end
    local lines = {}
    for line in content:gmatch("([^\n]*)\n") do lines[#lines + 1] = line end
    if #lines < 3 or (lines[1] ~= "GAMMA_AP_NOTICES|1" and lines[1] ~= "GAMMA_AP_NOTICES|2")
        or lines[2] ~= "session|" .. key then
        return nil, "Notice protocol or session mismatch"
    end
    local count = gamma_ap_protocol.canonical_number(lines[#lines]:match("^end|(.*)$"))
    if not count or count > 16 or count ~= #lines - 3 then
        return nil, "Notice count mismatch"
    end
    local result, ids = {}, {}
    for index = 3, #lines - 1 do
        local notice = record(lines[index], lines[1] == "GAMMA_AP_NOTICES|2")
        if not notice then return nil, "Malformed notice record" end
        local id, receipt = notice.id, notice.receipt
        if not id or not valid_id(id) or ids[id] or not receipt or receipt > 4000 then
            return nil, "Malformed notice record"
        end
        if (id:sub(1, 2) == "r:" and receipt ~= tonumber(id:sub(3)) + 1)
            or (id:sub(1, 2) == "s:" and receipt ~= 0) then
            return nil, "Notice receipt boundary mismatch"
        end
        ids[id] = true
        result[#result + 1] = notice
    end
    return result
end

function encode_ack(key, seen)
    local ids = {}
    for id, value in pairs(seen) do
        if type(id) ~= "string" or not valid_id(id) or value ~= true then
            return nil, "Invalid saved notice identity"
        end
        ids[#ids + 1] = id
    end
    if #ids > MAX_NOTICES then return nil, "Too many saved notice identities" end
    table.sort(ids)
    local lines = {"GAMMA_AP_NOTICES_ACK|1", "session|" .. key}
    for _, id in ipairs(ids) do lines[#lines + 1] = id end
    lines[#lines + 1] = "end|" .. #ids
    return table.concat(lines, "\n") .. "\n"
end

function poll(state)
    local root = gamma_ap_paths.appdata_root(getFS():update_path("$app_data_root$", ""))
    if not root then return false, "PDA notices require the isolated appdata root" end
    if not gamma_ap_loadout.pda_available(state) then return true end
    local file = io.open(root .. "archipelago\\notices.txt", "rb")
    if not file then return true end -- Older clients have no notice sidecar.
    local content = file:read(131073)
    local closed = file:close()
    if not closed then return false, "Notice read close failed" end
    local notices, reason = parse(content, state.session_key)
    if not notices then return false, reason end
    local delivered = false
    for _, notice in ipairs(notices) do
        if not delivered and not state.notices_seen[notice.id]
            and state.received_count >= notice.receipt then
            local ok = pcall(function()
                db.actor:give_game_news("Archipelago", gamma_ap_notice_text.render(notice), "ui_inGame2_D_Svyazist", 0, 5000)
            end)
            if not ok then return false, "PDA notice display failed; reward remains applied" end
            state.notices_seen[notice.id] = true
            delivered = true
        end
    end
    local acknowledgement, error = encode_ack(state.session_key, state.notices_seen)
    if not acknowledgement then return false, error end
    local output = io.open(root .. "archipelago\\notices_ack.txt", "wb")
    if not output then return false, "Cannot write notice acknowledgements" end
    local written = output:write(acknowledgement)
    local finished = output:close()
    if not written or not finished then return false, "Notice acknowledgement write failed" end
    return true
end
