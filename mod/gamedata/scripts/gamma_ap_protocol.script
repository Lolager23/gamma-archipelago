-- Data-only bridge codec. Keep compatible with Anomaly's LuaJIT/Lua 5.1.

function canonical_number(value)
    if not value or #value > 10 then return nil end
    if value ~= "0" and not value:match("^[1-9][0-9]*$") then return nil end
    return tonumber(value)
end

function parse_incoming(content)
    if type(content) ~= "string" or #content > 131072 or content:sub(-1) ~= "\n" then
        return nil, "Incomplete or oversized incoming snapshot"
    end
    local lines = {}
    for line in content:gmatch("([^\n]*)\n") do
        lines[#lines + 1] = line:gsub("\r$", "")
    end
    if #lines < 3 or (lines[1] ~= "GAMMA_AP_IN|1" and lines[1] ~= "GAMMA_AP_IN|2") then
        return nil, "Unsupported incoming protocol"
    end
    local key = lines[2]:match("^session|([0-9a-f]+)$")
    if not key or #key ~= 64 then return nil, "Invalid session identity" end
    local first_item, configuration_key = 3, nil
    if lines[1] == "GAMMA_AP_IN|2" then
        configuration_key = lines[3]:match("^configuration|([0-9a-f]+)$")
        if not configuration_key or #configuration_key ~= 64 then
            return nil, "Invalid configuration identity"
        end
        first_item = 4
    end
    local count = canonical_number(lines[#lines]:match("^end|(.*)$"))
    if not count or count > 4000 or count ~= #lines - first_item then
        return nil, "Incoming trailer does not match item history"
    end
    local items = {}
    for line_index = first_item, #lines - 1 do
        local index_text, id_text = lines[line_index]:match("^item|([^|]+)|([^|]+)$")
        local index, item_id = canonical_number(index_text), canonical_number(id_text)
        if index ~= line_index - first_item or not gamma_ap_catalog.item_sections[item_id] then
            return nil, "Unknown item or nonsequential item history"
        end
        items[#items + 1] = item_id
    end
    return { session_key = key, items = items, configuration_key=configuration_key }
end

function encode_outgoing(state)
    local lines = { "GAMMA_AP_OUT|1", "session|" .. state.session_key,
        "received|" .. tostring(state.received_count) }
    local count = 0
    local ids = {}
    for id in pairs(state.enabled_checks) do ids[#ids+1] = id end
    table.sort(ids)
    for _, id in ipairs(ids) do
        if state.checks[id] then
            count = count + 1
            lines[#lines + 1] = "check|" .. tostring(id)
        end
    end
    local complete = true
    for id in pairs(gamma_ap_catalog.pilot_ids) do
        if not state.checks[id] and not state.visited_maps[id] then complete = false end
    end
    lines[#lines + 1] = "goal|" .. (complete and "1" or "0")
    lines[#lines + 1] = "end|" .. tostring(count)
    return table.concat(lines, "\n") .. "\n"
end

function parse_confirmed(content, key, allowed)
    if type(content) ~= "string" or #content > 131072 or content:sub(-1) ~= "\n" then
        return nil, "Incomplete or oversized confirmed-check snapshot"
    end
    local lines = {}
    for line in content:gmatch("([^\n]*)\n") do lines[#lines + 1] = line end
    if #lines < 3 or lines[1] ~= "GAMMA_AP_CONFIRMED|1" or lines[2] ~= "session|" .. key then
        return nil, "Confirmed-check protocol or session mismatch"
    end
    local count = canonical_number(lines[#lines]:match("^end|(.*)$"))
    if not count or count ~= #lines - 3 or count > 4000 then
        return nil, "Confirmed-check count mismatch"
    end
    local known, checked = {}, {}
    for _, id in ipairs(gamma_ap_catalog.location_ids) do known[id] = true end
    known = allowed or known
    for index = 3, #lines - 1 do
        local id = canonical_number(lines[index]:match("^check|(.*)$"))
        local milestone = id and id > gamma_ap_catalog.kill_milestone_base
            and id <= gamma_ap_catalog.kill_milestone_base + gamma_ap_catalog.kill_milestone_maximum
        milestone = milestone or (id and id > gamma_ap_catalog.side_task_milestone_base
            and id <= gamma_ap_catalog.side_task_milestone_base + gamma_ap_catalog.side_task_milestone_maximum)
        if (not known[id] and (allowed or not milestone)) or checked[id] then
            return nil, "Unknown, disabled or duplicate confirmed check"
        end
        checked[id] = true
    end
    return checked
end
