-- The sole owner of this save's AP state. Files and engine calls are injected.

function new_state()
    return { session_key = nil, received_count = 0, checks = {}, applied_items = {}, notices_seen = {},
        configuration_key=nil, loadout_prepared=false, loadout_initialized=false, starting_pda_mode=0,
        expanded=false, enabled_checks=enabled_locations(nil), visited_maps={},
        combat=gamma_ap_combat.copy(nil), tasks=gamma_ap_tasks.copy(nil),
        equipment=gamma_ap_equipment_checks.copy(nil),
        rank_highest=-1, unlocks={}, quest_pending={}, gear_grants={}, zone_disabled={},
        reputation_targets={}, skill_plans=gamma_ap_skills.copy(nil),
        allowed_items=enabled_items(nil), configuration=nil, stashes=gamma_ap_stashes.copy(nil),
        artefact_sources={}, applying_reward=false }
end

function enabled_items(configuration)
    local result = {}
    for id, category in pairs(gamma_ap_catalog.item_categories) do
        if category == "" or (configuration and configuration.expanded
            and configuration.options[category] == 1) then result[id] = true end
    end
    return result
end

function enabled_locations(configuration)
    local enabled = {}
    if configuration and configuration.expanded then
        for id, category in pairs(gamma_ap_catalog.location_categories) do
            if configuration.options[category] == 1 then enabled[id] = true end
        end
        if configuration.options.checks_kill_milestones == 1 then
            for _, threshold in ipairs(configuration.thresholds.kill_milestones) do
                enabled[gamma_ap_catalog.kill_milestone_base + threshold] = true
            end
        end
        if configuration.options.checks_side_task_milestones == 1 then
            for _,threshold in ipairs(configuration.thresholds.side_task_milestones) do
                enabled[gamma_ap_catalog.side_task_milestone_base + threshold] = true
            end
        end
    else
        for id in pairs(gamma_ap_catalog.pilot_ids) do enabled[id] = true end
    end
    return enabled
end

function copy_state(state)
    local result = new_state()
    result.session_key = state.session_key
    result.received_count = state.received_count
    for key, value in pairs(state.checks) do result.checks[key] = value end
    for key, value in pairs(state.applied_items) do result.applied_items[key] = value end
    for key, value in pairs(state.notices_seen or {}) do result.notices_seen[key] = value end
    result.configuration_key = state.configuration_key
    result.loadout_prepared = state.loadout_prepared == true
    result.loadout_initialized = state.loadout_initialized == true
    result.starting_pda_mode = state.starting_pda_mode or 0
    result.loadout_plan = gamma_ap_loadout.copy_plan(state.loadout_plan)
    result.expanded = state.expanded == true
    result.combat = gamma_ap_combat.copy(state.combat)
    result.tasks = gamma_ap_tasks.copy(state.tasks)
    result.equipment = gamma_ap_equipment_checks.copy(state.equipment)
    for key,value in pairs(state.unlocks or {}) do result.unlocks[key] = value end
    for key,value in pairs(state.quest_pending or {}) do
        result.quest_pending[key] = {giver=value.giver}
    end
    for key,value in pairs(state.gear_grants or {}) do result.gear_grants[key] = value end
    for key,value in pairs(state.zone_disabled or {}) do result.zone_disabled[key] = value end
    result.rank_highest = state.rank_highest or -1
    result.skill_plans = gamma_ap_skills.copy(state.skill_plans)
    for key,value in pairs(state.reputation_targets or {}) do result.reputation_targets[key] = value end
    result.configuration = gamma_ap_configuration.copy(state.configuration)
    result.stashes = gamma_ap_stashes.copy(state.stashes)
    if state.allowed_items then
        result.allowed_items = {}
        for id,value in pairs(state.allowed_items) do result.allowed_items[id] = value end
    end
    for id, source in pairs(state.artefact_sources or {}) do result.artefact_sources[id] = source end
    for id, value in pairs(state.visited_maps or {}) do result.visited_maps[id] = value end
    if state.enabled_checks then
        result.enabled_checks = {}
        for id, value in pairs(state.enabled_checks) do result.enabled_checks[id] = value end
    end
    return result
end

function bind_session(state, incoming)
    if state.session_key and state.session_key ~= incoming.session_key then
        return false, "This save belongs to another AP seed or slot"
    end
    if state.received_count > #incoming.items then
        return false, "Received item history is shorter than this save"
    end
    for index = 1, state.received_count do
        if state.applied_items[index] ~= incoming.items[index] then
            return false, "Received item history conflicts with this save"
        end
    end
    state.session_key = incoming.session_key
    return true
end

function apply_pending(state, incoming, deliver_reward)
    local bound, reason = bind_session(state, incoming)
    if not bound then return false, reason end
    -- One item per update limits engine work and makes delivery failure visible.
    local next_index = state.received_count + 1
    local item_id = incoming.items[next_index]
    if not item_id then return true end
    if not state.allowed_items[item_id] or not gamma_ap_catalog.item_effects[item_id] then
        return false, "Reward type is disabled in this seed"
    end
    local target = gamma_ap_catalog.item_sections[item_id] or item_id
    local delivered, reason = deliver_reward(target)
    if not delivered then return false, reason or "Reward creation failed" end
    state.received_count = next_index
    state.applied_items[next_index] = item_id
    return true
end

function check_level(state, level_name)
    local location_id = gamma_ap_catalog.location_by_level[level_name]
    if location_id then
        state.visited_maps[location_id] = true
        if state.enabled_checks[location_id] then state.checks[location_id] = true end
    end
end

function merge_confirmed(state, checked)
    for id in pairs(checked) do state.checks[id] = true end
end
