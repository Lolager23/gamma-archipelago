-- Read-only logical readiness; native task/kill observers still own completed facts.
function reason(state,row,regions,id,observed_equipment)
    local config=state.configuration and state.configuration.options or {}
    if config.regional_progression ~= 1 then return end
    local needed=gamma_ap_catalog.check_readiness[id] or {}
    for _,group in ipairs({"firearms","outfit"}) do
        if needed[group] and gamma_ap_equipment_classes.level(state,group) < needed[group] then
            local label=gamma_ap_catalog.equipment_classes.groups[group].labels[needed[group]]
            local prefix=row.quota == "mutant" and "Mutant discovery equipment required: " or "Story equipment required: "
            return prefix..label
        end
    end
    -- Actual usable equipment can have been looted or bought without repairing it.
    if not observed_equipment and needed.tools and config.rewards_progressive_tools == 1
        and gamma_ap_workshop.tools_level(state) < needed.tools then
        local prefix=row.quota == "mutant" and "Mutant discovery readiness: "
            or row.category == "checks_weapon_tiers" and "AP placement logic: " or "Story readiness: "
        local suffix=row.weapon_grade == "D" and "; qualifying firearm use still counts" or ""
        return prefix..(needed.tools == 2 and "Advanced tools required" or "Expert tools required")..suffix
    end
    if gamma_ap_catalog.northern_readiness_checks[id] then
        local ok,shutdown=pcall(has_alife_info,"bar_deactivate_radar_done")
        local north=false
        for _,where in ipairs(gamma_ap_catalog.post_red_forest_regions) do north=north or regions[where] end
        if not ok or shutdown ~= true or not regions.l10_red_forest or not north then
            return "Disable Brain Scorcher and reach Red Forest plus another northern region"
        end
    end
    if row.quota == "artefact" and row.minimum > 20 and config.rewards_recipe_access == 1
        and not state.unlocks.recipe_artefact then return "Recipe Access: Artefacts required for discoveries 21 and above" end
end
