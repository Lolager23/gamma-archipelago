-- Reload-safe chat requests and diagnostics; never persist checks or receipts here.
local game_epoch
local bound,epoch,heartbeat,changed_at,live = nil,nil,nil,nil,false
local requests,next_sequence,entered = {},0,false
local request_key,last_ack,dirty = nil,0,false

local function plain(text, maximum)
    return type(text) == "string" and #text <= maximum and not text:find("[%z\1-\31\127%%<>|%[%]]")
end

local function hex(text)
    return (text:gsub(".",function(char) return string.format("%02x",char:byte()) end))
end

function parse(content, key, configuration)
    if type(content) ~= "string" or #content > 8192 or content:sub(-1) ~= "\n" then
        return nil,"Incomplete or oversized connection status"
    end
    local lines = {}
    for line in content:gmatch("([^\n]*)\n") do lines[#lines+1] = line end
    if #lines ~= 9 or lines[1] ~= "GAMMA_AP_STATUS|1" or lines[2] ~= "session|"..key
        or lines[3] ~= "configuration|"..(configuration or "-") or lines[9] ~= "end|1" then
        return nil,"Connection status identity mismatch"
    end
    local token,count = lines[4]:match("^heartbeat|([0-9a-f]+)|(%d+)$")
    local online,address = lines[5]:match("^connection|([01])|([0-9a-f]+)$")
    local game,ack = lines[6]:match("^ack|([0-9a-f%-]+)|(%d+)$")
    local confirmed = lines[7]:match("^confirmed|(%d+)$")
    local points,cost,total = lines[8]:match("^hint|(%d+)|(%d+)|(%d+)$")
    local values = {count,ack,confirmed,points,cost,total}
    for index=1,6 do
        values[index] = gamma_ap_protocol.canonical_number(values[index])
        if not values[index] or values[index] > 999999999 then return nil,"Invalid status counter" end
    end
    if not token or #token ~= 16 or not game or (game ~= "-" and #game ~= 16)
        or not address or #address%2 ~= 0 or #address > 4096 then return nil,"Malformed connection status" end
    address = address:gsub("%x%x",function(pair) return string.char(tonumber(pair,16)) end)
    if not plain(address,2048) then return nil,"Unsafe connection label" end
    return {epoch=token,heartbeat=values[1],connected=online=="1",address=address,
        game=game,ack=values[2],confirmed=values[3],points=values[4],cost=values[5],total=values[6]}
end

local function root_path()
    return gamma_ap_paths.bridge_root(getFS():update_path("$app_data_root$",""),io.open)
end

local function read(root, name, maximum)
    local file = io.open(root.."archipelago\\"..name,"rb")
    if not file then return nil,"Companion connection status unavailable" end
    local content,closed = file:read(maximum+1),file:close()
    if not closed then return nil,"Communication snapshot close failed" end
    return content
end

local function restore_requests(state)
    local root=root_path()
    local content,problem=read(root,"game_requests.txt",40000)
    if not content then return not problem or problem=="Companion connection status unavailable",problem end
    local lines={}
    for line in content:gmatch("([^\n]*)\n") do lines[#lines+1]=line end
    if lines[2] ~= "session|"..state.session_key or lines[3] ~= "configuration|"..(state.configuration_key or "-")
        or lines[4] ~= "game|"..game_epoch then return true end
    local target=(lines[5] or ""):match("^target|([0-9a-f]+)$")
    if #content > 40000 or content:sub(-1) ~= "\n" or lines[1] ~= "GAMMA_AP_COMMANDS|1"
        or #lines < 6 or #lines > 38 or not target or #target ~= 16
        or lines[#lines] ~= "end|"..(#lines-6) then return false,"Malformed cached AP requests" end
    local restored,previous={},0
    for index=6,#lines-1 do
        local sequence,kind,text=lines[index]:match("^request|(%d+)|([a-z]+)|([0-9a-f]*)$")
        sequence=gamma_ap_protocol.canonical_number(sequence)
        if not sequence or sequence <= previous or sequence > 999999999 or not text or #text > 1024 or #text%2 ~= 0
            or (kind ~= "loaded" and kind ~= "say") or (kind=="loaded") ~= (text=="") then return false,"Invalid cached AP request" end
        text=text:gsub("%x%x",function(pair) return string.char(tonumber(pair,16)) end)
        if text:find("[%z\1-\31\127]") then return false,"Unsafe cached AP request" end
        if sequence > last_ack then restored[#restored+1]={sequence=sequence,kind=kind,text=text} end
        previous=sequence
        if kind=="loaded" then entered=true end
    end
    requests,next_sequence=restored,math.max(next_sequence,previous)
    return true
end

local function bind(state)
    if request_key == state.session_key then return true end
    local changed=request_key ~= nil
    local progress,problem=gamma_ap_game_run.load(state)
    if not progress then return false,problem end
    game_epoch=progress.game
    requests,next_sequence,entered,last_ack={},progress.sequence,progress.entered,progress.ack
    if changed then next_sequence,entered,last_ack=0,false,0 end
    if not changed then
        local ok,reason=restore_requests(state)
        if not ok then return false,reason end
    end
    request_key=state.session_key
    dirty=next_sequence ~= progress.sequence or entered ~= progress.entered or changed
    return true
end

local function persist(state)
    if not dirty then return true end
    local ok,reason=gamma_ap_game_run.save(state,{game=game_epoch,sequence=next_sequence,ack=last_ack,entered=entered})
    if not ok then return false,reason end
    dirty=false
    return true
end

function view(state, now)
    local empty = {status="Companion connection status unavailable",fresh=false,connected=false,pending="unknown"}
    if not state.session_key then return empty end
    local bound_ok,bound_error=bind(state)
    if not bound_ok then empty.status=bound_error;return empty end
    local root = root_path()
    if not root then empty.status="Communication requires isolated appdata"; return empty end
    local content,reason = read(root,"connection_status.txt",8192)
    if not content then empty.status=reason; return empty end
    local frame,problem = parse(content,state.session_key,state.configuration_key)
    if not frame then empty.status=problem; return empty end
    if bound ~= state.session_key or epoch ~= frame.epoch then
        bound,epoch,heartbeat,changed_at,live = state.session_key,frame.epoch,frame.heartbeat,now,false
    elseif frame.heartbeat > heartbeat then heartbeat,changed_at,live=frame.heartbeat,now,true
    elseif frame.heartbeat < heartbeat then empty.status="Outdated connection status refused"; return empty end
    if now < changed_at then changed_at,live=now,false end
    frame.fresh = live and now-changed_at <= 5000
    frame.status = not frame.fresh and "Cached status; companion heartbeat unavailable"
        or frame.connected and "Connected to AP server: "..frame.address or "Disconnected from AP server: "..frame.address
    local confirmed_text = read(root,"confirmed_checks.txt",131072)
    local confirmed = confirmed_text and gamma_ap_protocol.parse_confirmed(confirmed_text,state.session_key,state.enabled_checks)
    frame.pending = "unknown"
    if confirmed then
        frame.pending = 0
        for id in pairs(state.checks) do if not confirmed[id] then frame.pending=frame.pending+1 end end
    end
    if frame.game == game_epoch then
        if frame.ack > last_ack then
            last_ack,next_sequence,dirty=frame.ack,math.max(next_sequence,frame.ack),true
        end
        while requests[1] and requests[1].sequence <= frame.ack do table.remove(requests,1) end
    end
    return frame
end

local function enqueue(kind,text)
    if next_sequence >= 999999999 then return false,"AP request counter exhausted; restart GAMMA" end
    if #requests >= 32 then return false,"AP message queue is full; reconnect before sending more" end
    next_sequence,dirty = next_sequence+1,true
    requests[#requests+1] = {sequence=next_sequence,kind=kind,text=text}
    return true,"Queued for Archipelago; awaiting companion submission"
end

local function write_requests(state, target)
    local lines = {"GAMMA_AP_COMMANDS|1","session|"..state.session_key,
        "configuration|"..(state.configuration_key or "-"),"game|"..game_epoch,"target|"..target}
    for _,request in ipairs(requests) do
        lines[#lines+1] = "request|"..request.sequence.."|"..request.kind.."|"..hex(request.text)
    end
    lines[#lines+1] = "end|"..#requests
    local root = root_path()
    if not root then return false,"Communication requires isolated appdata" end
    local file = io.open(root.."archipelago\\game_requests.txt","wb")
    if not file then return false,"Cannot write AP game requests" end
    local written,closed = file:write(table.concat(lines,"\n").."\n"),file:close()
    if not written or not closed then return false,"AP game request write failed" end
    return persist(state)
end

function flush(state, now)
    if not state.session_key then return true end
    local ok,reason=bind(state)
    if not ok then return false,reason end
    if #requests == 0 then return persist(state) end
    local frame = view(state,now)
    if not frame.fresh then return true end
    return write_requests(state,frame.epoch)
end

function say(state,text)
    if not state.session_key then return false,"Load an Archipelago game first" end
    local ok,reason=bind(state)
    if not ok then return false,reason end
    if type(text) ~= "string" or #text == 0 or #text > 512 or text:find("[%z\1-\31\127]") then
        return false,"AP message is empty, too long, or contains a line break/control character"
    end
    local queued,reason = enqueue("say",text)
    if not queued then return false,reason end
    local written,problem = flush(state,time_continual())
    return true,written and reason or "Queued; "..problem
end

function poll(state, now)
    if not state.session_key or not gamma_ap_readiness.ready() then return true end
    local ok,reason=bind(state)
    if not ok then return false,reason end
    local frame = view(state,now)
    if not frame.fresh then return true end
    if not entered and #requests < 32 then
        local queued,problem=enqueue("loaded","")
        if not queued then return false,problem end
        entered = true
    end
    if #requests == 0 then return persist(state) end
    return write_requests(state,frame.epoch)
end

function print_status(state)
    local frame = view(state,time_continual())
    local text = frame.status..". Checks awaiting server confirmation: "..frame.pending.."."
    printf("[GAMMA AP] %s",text)
    if not db.actor or not db.actor:alive() then return false end
    local shown = pcall(function() db.actor:give_game_news("Archipelago",text,"ui_inGame2_D_Svyazist",0,5000) end)
    return shown
end
