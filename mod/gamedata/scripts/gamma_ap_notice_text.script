-- Render structured notices in the game's language, without parsing English prose.
local templates = {
    received_item='{player} gave you "{item}".',
    received_unlock='{player} unlocked your "{item}".',
    sent_item='You sent "{item}" to {player}.',
    sent_unlock='You unlocked "{item}" for {player}.',
}

local function plain(text, maximum)
    return type(text) == "string" and #text > 0 and #text <= maximum
        and not text:find("[%z\1-\31\127%%<>|%[%]]")
end

local function translated(key)
    local ok, text = pcall(function() return game.translate_string(key) end)
    if ok and text ~= key then return text end
end

function valid(kind, player, item, local_id, cause_kind, cause_value)
    local cause_valid = cause_kind == nil and cause_value == nil
        or gamma_ap_catalog.notice_cause_templates[cause_kind] ~= nil and plain(cause_value,384)
    return templates[kind] ~= nil and plain(player, 384) and plain(item, 384)
        and (local_id == 0 or gamma_ap_catalog.item_effects[local_id] ~= nil)
        and cause_valid
end

local function valid_template(text, fields)
    if not plain(text, 512) then return false end
    local counts, unknown = {}, false
    local remaining = text:gsub("{([^{}]*)}", function(key)
        if fields[key] == nil then unknown = true end
        counts[key] = (counts[key] or 0)+1
        return ""
    end)
    for key in pairs(fields) do if counts[key] ~= 1 then return false end end
    return not unknown and not remaining:find("[{}]")
end

local function render_template(key, fallback, fields)
    local template = translated(key)
    if not valid_template(template,fields) then template = fallback end
    local text = template:gsub("{([a-z_]+)}", function(name) return fields[name] end)
    return text
end

function render(notice, shared_loner)
    if not notice.kind then return notice.text end -- Older client sidecar.
    local fallback = templates[notice.kind]
    local converted = shared_loner and notice.local_item_id == 28051301 and notice.kind:sub(1,9) == "received_"
    local item = converted and gamma_ap_catalog.tracker_item_names[gamma_ap_catalog.shared_goodwill_id] or notice.item
    local item_id = converted and gamma_ap_catalog.shared_goodwill_id or notice.local_item_id
    if item_id ~= 0 then
        local label = translated("gamma_ap_reward_" .. item_id)
        if plain(label, 384) then item = label end
    end
    local fields = {player=notice.player, item=item}
    local key = "gamma_ap_notice_" .. notice.kind
    if notice.cause_kind then
        key = key .. "_cause"
        fallback = fallback:sub(1,-2) .. " {cause}."
        local value = notice.cause_value
        if notice.cause_kind ~= "check" and notice.cause_kind ~= "source" then
            local hex = value:gsub(".",function(char) return string.format("%02x",char:byte()) end)
            local label = translated("gamma_ap_cause_value_"..notice.cause_kind.."_"..hex)
            if plain(label,384) then value = label end
        end
        fields.cause = render_template("gamma_ap_cause_"..notice.cause_kind,
            gamma_ap_catalog.notice_cause_templates[notice.cause_kind],{value=value})
    end
    -- One pass; a label containing {item} or a pattern character stays literal.
    return render_template(key,fallback,fields)
end

function stash_inventory(item_id)
    local item = translated("gamma_ap_reward_"..item_id)
    if not plain(item,384) then item = gamma_ap_catalog.tracker_item_names[item_id] end
    local sections = gamma_ap_catalog.stash_contents[item_id]
    if sections and #sections == 1 then
        local ok,key = pcall(function() return ini_sys:r_string_ex(sections[1],"inv_name") end)
        local native = ok and type(key) == "string" and translated(key)
        if plain(native,384) then item = native end
    end
    return render_template("gamma_ap_stash_inventory_delivery",
        'Archipelago stash: "{item}" was delivered directly to your inventory.',{item=item})
end
