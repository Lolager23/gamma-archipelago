-- Companion-validated configuration, bound to the digest in the v2 item snapshot.

function copy(configuration)
    if not configuration then return nil end
    local result = {digest=configuration.digest, expanded=configuration.expanded, options={}, thresholds={},exclusions={}}
    for token,value in pairs(configuration.exclusions or {}) do result.exclusions[token] = value end
    for name,value in pairs(configuration.options) do result.options[name] = value end
    for name,values in pairs(configuration.thresholds) do
        result.thresholds[name] = {}
        for _,value in ipairs(values) do result.thresholds[name][#result.thresholds[name]+1] = value end
    end
    return result
end

function parse(content, key, digest)
    if type(content) ~= "string" or #content > 131072 or content:sub(-1) ~= "\n" then
        return nil, "Incomplete or oversized configuration snapshot"
    end
    local lines = {}
    for line in content:gmatch("([^\n]*)\n") do lines[#lines + 1] = line end
    if #lines < 4 or (lines[1] ~= "GAMMA_AP_CONFIG|1" and lines[1] ~= "GAMMA_AP_CONFIG|2")
        or lines[2] ~= "session|" .. key
        or lines[3] ~= "digest|" .. digest then
        return nil, "Configuration protocol, session or digest mismatch"
    end
    local count = gamma_ap_protocol.canonical_number(lines[#lines]:match("^end|(.*)$"))
    if not count or count ~= #lines - 4 or count > 256 then
        return nil, "Configuration record count mismatch"
    end
    local result = {digest=digest, options={}, exclusions={}, thresholds={kill_milestones={}, side_task_milestones={}}}
    result.expanded = lines[1] == "GAMMA_AP_CONFIG|2"
    for index = 4, #lines - 1 do
        local name, number = lines[index]:match("^option|([a-z_]+)|(%d+)$")
        if name then
            local value = gamma_ap_protocol.canonical_number(number)
            local maximum = gamma_ap_catalog.config_limits[name]
            if not value or not maximum or value > maximum or result.options[name] ~= nil then
                return nil, "Unknown, duplicate or invalid configuration option"
            end
            result.options[name] = value
        elseif lines[index]:sub(1,8) == "exclude|" then
            local token = lines[index]:sub(9)
            local known = false
            for _,source in pairs(gamma_ap_catalog.discovery_sources) do if source.token == token then known = true end end
            if not known or result.exclusions[token] then return nil,"Unknown or duplicate discovery exclusion" end
            result.exclusions[token] = true
        else
            name, number = lines[index]:match("^threshold|([a-z_]+)|(%d+)$")
            local values = name and result.thresholds[name]
            local value = gamma_ap_protocol.canonical_number(number)
            if not values or not value or value < 1 or value > 10000 or #values >= 20
                or (#values > 0 and values[#values] >= value) then
                return nil, "Invalid milestone configuration"
            end
            values[#values + 1] = value
        end
    end
    for name,value in pairs(gamma_ap_catalog.config_defaults) do
        if result.options[name] == nil then result.options[name] = value end
    end
    for name in pairs(gamma_ap_catalog.config_limits) do
        if result.options[name] == nil then return nil, "Configuration option is missing" end
    end
    if #result.thresholds.kill_milestones == 0 or #result.thresholds.side_task_milestones == 0 then
        return nil, "Configuration milestone list is missing"
    end
    local selected,reason = gamma_ap_discovery.select(result,{})
    if not selected then return nil,reason end
    return result
end
