-- Read-only presentation. Availability means AP requirements, not ALife spawn proof.
local psi_regions = {l10_radar=true, l10u_bunker=true, l08u_brainlab=true}
local equipment = {checks_artefacts="detector", checks_armour_tiers="outfit",
    checks_weapon_tiers="firearms", checks_knife_tiers="melee",
    checks_quest_types="pda", checks_side_task_milestones="pda", checks_story_milestones="pda",checks_gear_upgrades="tools"}
local combat = {checks_mutant_first_kills=true, checks_faction_first_kills=true,
    checks_kill_milestones=true}
PAGE_SIZE = 4

local function options(state)
    return state.configuration and state.configuration.options or {}
end

local function definition(id)
    if gamma_ap_catalog.tracker_checks[id] then return gamma_ap_catalog.tracker_checks[id] end
    local task = id >= gamma_ap_catalog.side_task_milestone_base
    local base = task and gamma_ap_catalog.side_task_milestone_base or gamma_ap_catalog.kill_milestone_base
    local category = task and "checks_side_task_milestones" or "checks_kill_milestones"
    return {name=gamma_ap_catalog.tracker_milestones[category]:gsub("{count}",tostring(id-base)),
        region="Menu", category=category, minimum=id-base, quests={}}
end

local function level_allowed(state, where, psi)
    return gamma_ap_zone_keys.allowed(state, where) and (not psi_regions[where] or psi == true)
end

function reachable(state, psi)
    local result, changed = {[gamma_ap_start.level_name(state.configuration)]=true}, true
    while changed do
        changed = false
        for _, edge in ipairs(gamma_ap_catalog.tracker_connections) do
            if result[edge[1]] and not result[edge[2]] and level_allowed(state, edge[2], psi) then
                result[edge[2]], changed = true, true
            end
            if result[edge[2]] and not result[edge[1]] and level_allowed(state, edge[1], psi) then
                result[edge[1]], changed = true, true
            end
        end
    end
    return result
end

local function blocked(state, row, regions, psi, id, standing)
    local config = options(state)
    if row.region ~= "Menu" and not regions[row.region] then
        if not gamma_ap_zone_keys.allowed(state, row.region) then return "Zone access key required" end
        if psi_regions[row.region] and psi ~= true then return "Usable calibrated psi protection required" end
        return "An accessible route through connected regions is required"
    end
    local accessible,reliable = gamma_ap_activity.available(state,row,regions,id)
    if not accessible then return "Regional activity: reach the required source regions or more distinct source types" end
    local practical = gamma_ap_playability.reason(state,row,regions,psi)
    if practical then return practical end
    local diplomacy,optional = gamma_ap_settlement_access.reason(state,id,standing)
    if diplomacy then return diplomacy end
    if config.rewards_progressive_tools == 1 and row.category == "checks_gear_upgrades"
        and gamma_ap_workshop.tools_level(state) < 3 then return "Expert tool permission required" end
    if config.content_progression == 1 and config.rewards_progressive_tools == 1
        and row.category == "checks_gear_upgrades" and not regions.l01_escape then
        return "Cordon tool-stash retrieval route required for guaranteed physical kits"
    end
    if config.rewards_workshop_access == 1 and row.category == "checks_gear_upgrades"
        and not state.unlocks.workshop_upgrade then return "Workshop upgrade permission required" end
    local group = equipment[row.category]
    if group and config["starting_"..group] == 2 and not state.unlocks["gear_"..group] then
        return "Equipment permission required: " .. group
    end
    local fighting = combat[row.category] or (row.category == "checks_quest_types"
        and (row.key == "hunting" or row.key == "bounty" or row.key == "rescue" or row.key == "defence"
            or row.key == "assault" or row.key == "territory" or row.key == "vehicle"))
        or (gamma_ap_catalog.activity_rules[id] and gamma_ap_catalog.activity_rules[id].combat == true)
    local weapon = config.starting_firearms ~= 2 or config.starting_melee ~= 2
        or state.unlocks.gear_firearms or state.unlocks.gear_melee
    if fighting and not weapon then
        return "A firearm or melee permission is required"
    end
    if ((row.category == "checks_rank_milestones" and row.minimum > 0) or (row.category == "checks_faction_standing" and not (config.playability_logic == 1 and config.rewards_faction_reputation == 1)))
        and not weapon and config.starting_pda == 2 and not state.unlocks.gear_pda then
        return "A PDA, firearm or melee permission is required to earn rank or standing"
    end
    if fighting and (config.combat_logic or 0) > 0 then
        local groups = config.combat_logic == 1 and {"firearms"} or {"firearms","outfit","helmet"}
        for _,name in ipairs(groups) do
            if config["starting_"..name] == 2 and not state.unlocks["gear_"..name] then
                return "Combat equipment permission required: "..name
            end
        end
    end
    if config.rewards_quest_keys == 1 then
        for _, key in ipairs(row.quests) do
            if not state.unlocks[key] then return gamma_ap_catalog.tracker_permissions[key] .. " required" end
        end
    end
    return nil,optional or not reliable
end

local function progression_entry(result, group, text)
    result.progression[#result.progression+1] = text
    local entries = result.progression_groups[group]
    entries[#entries+1] = text
end

function snapshot(state, total, problem, psi, standing)
    local result = {rows={}, regions={}, completed=0, available=0, blocked=0, progression={}}
    result.progression_groups = {status={}, unlocked={}, exploration={}, locked={}}
    result.enabled = options(state).pda_tracker ~= 0
    result.bound = state.session_key ~= nil and not state.refused_save
    result.goal = state.configuration and state.configuration.options.goal or 0
    result.goal_complete = state.goal_complete
    result.applied, result.total = state.received_count, math.max(total or 0,state.received_count)
    result.pending = result.total-result.applied
    result.kills, result.tasks, result.rank = state.combat.kills, state.tasks.count, state.rank_highest
    result.problem = problem
    result.delivery = gamma_ap_deliveries.summary(state)
    if not result.bound or not result.enabled then return result end
    local regions = reachable(state, psi)
    for id in pairs(state.enabled_checks) do
        local row = definition(id)
        local reason,optional
        if not state.checks[id] then reason,optional = blocked(state,row,regions,psi,id,standing) end
        local status = state.checks[id] and "completed" or (reason and "blocked" or "available")
        local region = gamma_ap_catalog.tracker_regions[row.region] or "Global activities"
        result.rows[#result.rows+1] = {id=id, name=row.name, region=region, status=status,
            category=row.category, reason=reason or (type(optional) == "string" and optional or (optional and "Optional check: source availability unverified; progression excluded"
                or "Requirements met; encounter/task availability is not guaranteed"))}
        result[status] = result[status]+1
        result.regions[region] = true
    end
    table.sort(result.rows,function(a,b) return a.id < b.id end)
    for key, name in pairs(gamma_ap_catalog.tracker_permissions) do
        local prefix = state.unlocks[key] and "Unlocked: " or "Locked: "
        local item_enabled = false
        for id in pairs(state.allowed_items) do
            if gamma_ap_catalog.permissions[id] == key then item_enabled = true end
        end
        if item_enabled then progression_entry(result,state.unlocks[key] and "unlocked" or "locked",prefix..name) end
    end
    progression_entry(result,"status",psi and "Calibrated psi protection: usable" or "Calibrated psi protection: not confirmed")
    for where in pairs(gamma_ap_catalog.lab_levels) do
        local visited = state.visited_maps[gamma_ap_catalog.location_by_level[where]]
        progression_entry(result,"exploration",(visited and "Visited: " or "Unvisited: ")..gamma_ap_catalog.tracker_regions[where])
    end
    if options(state).rewards_progressive_tools == 1 then
        progression_entry(result,"status","Progressive tools: "..gamma_ap_workshop.tools_level(state).."/3")
    end
    if options(state).rewards_convenience == 1 then
        progression_entry(result,"status","AP carry permission: +"..gamma_ap_convenience.bonus(state).." kg (cap 15 kg)")
    end
    if result.delivery then progression_entry(result,"status",result.delivery) end
    local coordinates,claimed = 0,0
    for _,record in pairs(state.stashes.records) do
        coordinates = coordinates+1
        if record.claimed then claimed=claimed+1 end
    end
    if coordinates > 0 then
        result.stash_delivery = "Stash deliveries: "..coordinates.." coordinates received, "..claimed.." claimed"
        progression_entry(result,"status",result.stash_delivery)
    end
    table.sort(result.progression)
    for _,entries in pairs(result.progression_groups) do table.sort(entries) end
    return result
end

function page(view, region, status, offset)
    local rows = {}
    for _,row in ipairs(view.rows) do
        if (not region or row.region == region) and (not status or row.status == status) then
            rows[#rows+1] = row
        end
    end
    local last = math.floor(math.max(0,#rows-1)/PAGE_SIZE)*PAGE_SIZE+1
    local start = math.max(1,math.min(offset or 1,last))
    local result = {}
    for index=start,math.min(start+PAGE_SIZE-1,#rows) do result[#result+1] = rows[index] end
    return result,start,#rows
end
