-- Finite first acquisitions; contained aliases and condition share one type.

function observe(state, item, source)
    if not state.session_key or not state.expanded or state.applying_reward
        or not db.actor or not db.actor:alive() or not item then return end
    if source ~= "ownership" and source ~= "container" then return end
    local id = gamma_ap_catalog.artefact_locations[item:section()]
    if not id then return end
    if gamma_ap_discovery.record(state,id) and not state.artefact_sources[id] then state.artefact_sources[id] = source end
end
