-- DXML requires the modxml_ prefix; this adds only AP-owned marker definitions.

local complete = false
local definitions = {
{name="gamma_ap_loot", xml=[[
<gamma_ap_loot hint="st_ui_pda_secret">
    <level_map spot="gamma_ap_loot_spot" pointer="quest_pointer"/>
    <mini_map spot="gamma_ap_loot_spot"/>
</gamma_ap_loot>
]]},
{name="gamma_ap_loot_spot", xml=[[
<gamma_ap_loot_spot width="12" height="12" alignment="c" stretch="1">
    <texture a="255" r="255" g="255" b="255">ui_inGame2_PDA_icon_secret</texture>
</gamma_ap_loot_spot>
]]},
{name="gamma_ap_progression", xml=[[
<gamma_ap_progression hint="st_ui_pda_secret">
    <level_map spot="gamma_ap_progression_spot" pointer="quest_pointer"/>
    <mini_map spot="gamma_ap_progression_spot"/>
</gamma_ap_progression>
]]},
{name="gamma_ap_progression_spot", xml=[[
<gamma_ap_progression_spot width="12" height="12" alignment="c" stretch="1">
    <texture a="255" r="255" g="144" b="16">ui_inGame2_PDA_icon_secret</texture>
</gamma_ap_progression_spot>
]]},
}

function ready()
    return complete
end

local function has_definitions(xml)
    for _,definition in ipairs(definitions) do
        if #xml:query(definition.name) ~= 1 then return false end
    end
    return true
end

function patch(file, xml)
    local name = file:gsub("/", "\\"):lower()
    if name ~= "ui\\map_spots.xml" and name ~= "ui\\map_spots_16.xml"
        and name ~= "ui\\map_spots_21.xml" and name ~= "ui\\map_spots_219.xml" then return end
    complete = false
    -- DXML selectors search children: the map_spots root cannot select itself.
    local root = xml:getRoot()
    if not root or xml:getElementName(root) ~= "map_spots" then return end
    for _,definition in ipairs(definitions) do
        if not xml:query(definition.name)[1] then
            xml:insertFromXMLString(definition.xml, root, #root.kids + 1)
        end
    end
    complete = has_definitions(xml)
end

function on_xml_read()
    complete = false
    RegisterScriptCallback("on_xml_read", patch)
    registered = true
end
